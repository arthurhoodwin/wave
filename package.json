{
  "name": "wave-vk-research-client",
  "version": "1.1.0-beta.5",
  "private": false,
  "description": "Windows music client with an independent VK network adapter and local audio player",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "research": "electron . --research-session",
    "test": "node --test --test-timeout=15000 tests/*.test.cjs",
    "dist": "node scripts/prepare.cjs && electron-builder --win nsis --x64 --publish never",
    "release": "node scripts/release.cjs",
    "release:check": "node scripts/release.cjs --check",
    "artifacts:clean": "node scripts/clean-artifacts.cjs --apply"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "axe-core": "4.14.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "htmlparser2": "12.0.0"
  },
  "author": "Wave contributors",
  "build": {
    "appId": "app.wave.vk",
    "productName": "Wave",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "asar": true,
    "files": [
      "src/**/*",
      "assets/icons/wave.ico",
      "assets/icons/wave.png",
      "build/update-public.pem",
      "build/windows/apply-update.ps1",
      "LICENSE",
      "COPYRIGHT",
      "docs/THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/wave.ico",
      "artifactName": "Wave-Setup-1.1.0-beta.5.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wave",
      "uninstallDisplayName": "Wave",
      "deleteAppDataOnUninstall": false,
      "include": "build/windows/installer.nsh",
      "installerIcon": "assets/icons/wave.ico",
      "uninstallerIcon": "assets/icons/wave.ico",
      "runAfterFinish": true
    },
    "forceCodeSigning": false,
    "asarUnpack": [
      "build/windows/apply-update.ps1"
    ],
    "buildVersion": "1.1.0.105"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/arthurhoodwin/wave.git"
  },
  "homepage": "https://github.com/arthurhoodwin/wave#readme",
  "bugs": {
    "url": "https://github.com/arthurhoodwin/wave/issues"
  },
  "releaseVersion": "1.1.0-beta.5",
  "releaseChannel": "beta",
  "updateMode": "bootstrap"
}
